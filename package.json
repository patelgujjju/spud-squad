{
  "name": "spud-squad",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* run dev",
    "test": "pnpm test:shared && pnpm test:server",
    "test:shared": "vitest run",
    "test:server": "pnpm --filter @spud-squad/shared build && pnpm --filter @spud-squad/server test",
    "test:client": "pnpm --filter @spud-squad/client test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:levels": "pnpm --filter @spud-squad/shared run build && node tools/validate/index.mjs",
    "deploy": "pnpm --filter @spud-squad/server run deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
