{
  "name": "@spud-squad/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @spud-squad/shared build && vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build && node ../../tools/check-bundle.mjs && node art/check-assets.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "playwright test",
    "capture:slice": "node art/capture-slice.mjs",
    "art:build": "node art/fetch-sources.mjs && node art/build-textures.mjs && node art/build-models.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@spud-squad/shared": "workspace:*",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@gpu-tex-enc/basis": "^1.16.4",
    "@playwright/test": "1.64.1",
    "@types/three": "0.186.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5"
  }
}
