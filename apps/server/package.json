{
  "name": "@spud-squad/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @spud-squad/shared build && wrangler dev --ip 0.0.0.0 --port 8787",
    "test": "vitest run --config vitest.config.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@spud-squad/shared": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261024.1"
  }
}
